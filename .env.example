# Supabase — obtenha esses valores em: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# PostHog Analytics — https://posthog.com (opcional; deixe em branco para desativar analytics)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Supabase Edge Functions secrets (configurar via: supabase secrets set)
# RESEND_API_KEY=re_...          — emails transacionais (https://resend.com)
# ANTHROPIC_API_KEY=sk-ant-...   — já configurado nos secrets do projeto
